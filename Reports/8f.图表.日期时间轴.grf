{
	"Version":"6.8.1.0",
	"Title":"8f.图表.日期时间轴",
	"Author":"锐浪报表软件",
	"Description":"图表轴按日期时间格式显示\r\n\r\n实现要点：\r\n1、设置X轴的“日期时间轴”属性\r\n2、设置X轴的“文字格式”属性\r\n3、序列中轴对应的字段类型应该是日期时间类型的",
	"Font":{
		"Name":"宋体",
		"Size":90000,
		"Weight":400,
		"Charset":134
	},
	"ProcessBeginScript":"//Chart2\r\n{\r\n    var chart2 = Report.ControlByName(\"Chart2\");\r\n\r\n    //设置 Chart2 的X轴的 Min、Max与Space属性。这几个属性值1表示一天\r\n    //如果要分钟或秒表示的值，应该将其转换为天，即分钟数要除(24*60)，秒数要除(24*60*60)\r\n    chart2.XAxis.Min = Report.ParameterByName(\"BeginDate\").AsFloat;\r\n    chart2.XAxis.Max = Report.ParameterByName(\"EndDate\").AsFloat;\r\n    chart2.XAxis.Space = 5; //5天为步长单位。如果要以800分钟为步长单位，代码为chart2.XAxis.Space = 800/(24*60);\r\n\r\n    //如果要按指定的日期时间值设置代码如下\r\n    //var dt = Report.Utility.CreateDateTime();\r\n    //dt.ValueFromDate(1997,6,1);\r\n    //chart2.XAxis.Min = dt.AsFloat;\r\n    //dt.ValueFromDate(1997,6,30);\r\n    //chart2.XAxis.Max = dt.AsFloat;\r\n}\r\n\r\n\r\n\r\n//Chart3\r\n{\r\n    //var chart3 = Report.ControlByName(\"Chart3\");\r\n    //chart3.XAxis.Max = ...;\r\n}",
	"ConnectionString":"Provider=Microsoft.Jet.OLEDB.4.0;\r\nUser ID=Admin;\r\nData Source=..\\Data\\Northwind.mdb",
	"Printer":{
		"LeftMargin":1.5,
		"RightMargin":1.5
	},
	"DetailGrid":{
		"CenterView":true,
		"FixCols":1,
		"PageColumnDirection":"DownAcrossEqual",
		"PageColumnCount":2,
		"PrintAdaptMethod":"Discard",
		"ColLine":{
			"Color":"646F71"
		},
		"RowLine":{
			"Color":"646F71"
		},
		"Recordset":{
			"QuerySQL":"select t.CategoryName, m.OrderDate, sum(d.UnitPrice*d.Quantity) as Amount\r\nfrom (Orders m inner join OrderDetails d on m.OrderId=d.OrderId)\r\ninner join (Products p inner join Categories t on p.CategoryID=t.CategoryID) on p.ProductID=d.ProductID\r\nwhere m.OrderDate between :BeginDate and :EndDate and t.CategoryID<=3\r\ngroup by t.CategoryName, m.OrderDate\r\norder by t.CategoryName, m.OrderDate",
			"Field":[
				{
					"Name":"OrderDate",
					"Type":"DateTime",
					"Format":"yyyy/MM/dd"
				},
				{
					"Name":"Amount",
					"Type":"Currency",
					"Format":"#,##0.00;;#"
				},
				{
					"Name":"CategoryName"
				}
			]
		},
		"Column":[
			{
				"Name":"CategoryName",
				"Width":2.67229
			},
			{
				"Name":"OrderDate",
				"Width":3.38667
			},
			{
				"Name":"Amount",
				"Width":2.51354
			}
		],
		"ColumnContent":{
			"Height":0.608542,
			"ColumnContentCell":[
				{
					"Column":"CategoryName",
					"DataField":"CategoryName"
				},
				{
					"Column":"OrderDate",
					"DataField":"OrderDate"
				},
				{
					"Column":"Amount",
					"TextAlign":"MiddleRight",
					"DataField":"Amount"
				}
			]
		},
		"ColumnTitle":{
			"Height":0.79375,
			"Font":{
				"Name":"宋体",
				"Size":90000,
				"Bold":true,
				"Charset":134
			},
			"RepeatStyle":"OnPageColumn",
			"ColumnTitleCell":[
				{
					"GroupTitle":false,
					"Column":"CategoryName",
					"TextAlign":"MiddleCenter",
					"Text":"产品"
				},
				{
					"GroupTitle":false,
					"Column":"OrderDate",
					"TextAlign":"MiddleCenter",
					"Text":"OrderDate"
				},
				{
					"GroupTitle":false,
					"Column":"Amount",
					"TextAlign":"MiddleCenter",
					"Text":"Amount"
				}
			]
		}
	},
	"Parameter":[
		{
			"Name":"BeginDate",
			"DataType":"DateTime",
			"Value":"1997/6/1"
		},
		{
			"Name":"EndDate",
			"DataType":"DateTime",
			"Value":"1997/6/30"
		}
	],
	"ReportFooter":[
		{
			"Name":"ReportFooter1",
			"Height":7.19667,
			"Control":[
				{
					"Type":"Chart",
					"Name":"Chart1",
					"Dock":"Fill",
					"Title":"Chart1:日期时间轴",
					"Font":{
						"Name":"宋体",
						"Size":105000,
						"Weight":400,
						"Charset":134
					},
					"TitleFont":{
						"Name":"宋体",
						"Size":120000,
						"Bold":true,
						"Charset":134
					},
					"GroupCount":4,
					"SeriesCount":3,
					"BarWidthPercent":85,
					"SeriesField":"CategoryName",
					"Recordset":{
						"QuerySQL":"select t.CategoryName, m.OrderDate, sum(d.UnitPrice*d.Quantity) as Amount\r\nfrom (Orders m inner join OrderDetails d on m.OrderId=d.OrderId)\r\ninner join (Products p inner join Categories t on p.CategoryID=t.CategoryID) on p.ProductID=d.ProductID\r\nwhere m.OrderDate between :BeginDate and :EndDate and t.CategoryID<=3\r\ngroup by t.CategoryName, m.OrderDate\r\norder by t.CategoryName, m.OrderDate",
						"Field":[
							{
								"Name":"CategoryName"
							},
							{
								"Name":"OrderDate",
								"Type":"DateTime"
							},
							{
								"Name":"Amount",
								"Type":"Float"
							}
						]
					},
					"XAxis":{
						"Label":"季度",
						"TextAngle":-30,
						"TextFormat":"MM/dd",
						"DateTimeAxis":true,
						"CoordLinePen":{
							"Color":"FFC4C4"
						}
					},
					"YAxis":{
						"Label":"销售额",
						"TextFormat":"0.##",
						"CoordLinePen":{
							"Color":"FFC4C4"
						}
					},
					"Y2Axis":{
						"TextFormat":"0.##",
						"CoordLinePen":{
							"Color":"FFC4C4"
						}
					},
					"ChartSeries":[
						{
							"ChartType":"XYCurveLineChart",
							"XValueField":"OrderDate",
							"YValueField":"Amount",
							"ValueFormat":"0.##",
							"TooltipText":"[#ChartVar(SeriesLabel)#]([#ChartVar(YVal)#], [#ChartVar(XVal)#])"
						}
					]
				}
			]
		},
		{
			"Name":"ReportFooter2",
			"Height":7.19667,
			"Control":[
				{
					"Type":"Chart",
					"Name":"Chart2",
					"Dock":"Fill",
					"Title":"Chart2：日期时间轴(脚本：Max, Min, Space)",
					"Font":{
						"Name":"宋体",
						"Size":105000,
						"Weight":400,
						"Charset":134
					},
					"TitleFont":{
						"Name":"宋体",
						"Size":120000,
