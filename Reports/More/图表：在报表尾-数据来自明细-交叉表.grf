{
	"Version":"6.8.8.0",
	"Title":"8h.图表在分组-数据来自明细",
	"Author":"锐浪报表软件",
	"Description":"将图表定义在分组中，图表数据来自明细记录集:\r\n1、记录范围为当前分组项对应明细记录。\r\n2、图表记录集与明细记录集根据同名字段复制数据。",
	"Font":{
		"Name":"宋体",
		"Size":105000,
		"Weight":400,
		"Charset":134
	},
	"Printer":{
		"Oriention":"Landscape"
	},
	"DetailGrid":{
		"IsCrossTab":true,
		"FixCols":1,
		"ColLine":{
			"Color":"646F71"
		},
		"RowLine":{
			"Color":"646F71"
		},
		"Recordset":{
			"ConnectionString":"Provider=Microsoft.Jet.OLEDB.4.0;\r\nUser ID=Admin;\r\nData Source=..\\..\\Data\\Northwind.mdb",
			"QuerySQL":"select c.City,t.CategoryName,sum(d.Quantity*d.UnitPrice) as Amount\r\nfrom (Orders m inner join \r\n(OrderDetails d inner join \r\n(Products p inner join Categories t on p.CategoryID=t.CategoryID)\r\non P.ProductID=D.ProductID) on m.OrderId=d.OrderId)\r\nleft join Customers c on c.CustomerID=m.CustomerID\r\nwhere c.Region='华北' and m.OrderDate between #1/1/1997# and #12/31/1997#\r\ngroup by c.City,t.CategoryName\r\norder by c.City,CategoryName",
			"Field":[
				{
					"Name":"City"
				},
				{
					"Name":"CategoryName"
				},
				{
					"Name":"Amount",
					"Type":"Currency"
				}
			]
		},
		"Column":[
			{
				"Name":"City",
				"Width":3.175,
				"FixedWidth":true
			},
			{
				"Name":"Amount",
				"Width":2.40771
			},
			{
				"Name":"TotalColumn",
				"Width":3.59833,
				"FixedWidth":true
			}
		],
		"ColumnContent":{
			"Height":0.608542,
			"ColumnContentCell":[
				{
					"Column":"City",
					"DataField":"City"
				},
				{
					"Column":"Amount",
					"TextAlign":"MiddleRight",
					"DataField":"Amount"
				},
				{
					"Column":"TotalColumn",
					"TextAlign":"MiddleRight",
					"DataField":"Amount"
				}
			]
		},
		"ColumnTitle":{
			"BackColor":"E2EFF1",
			"Height":0.582083,
			"Font":{
				"Name":"宋体",
				"Size":105000,
				"Bold":true,
				"Charset":134
			},
			"RepeatStyle":"OnPage",
			"ColumnTitleCell":[
				{
					"GroupTitle":false,
					"Column":"City",
					"TextAlign":"MiddleCenter",
					"Text":"城市"
				},
				{
					"GroupTitle":false,
					"Column":"Amount",
					"FreeCell":true,
					"Control":[
						{
							"Type":"FieldBox",
							"Name":"FieldBox1",
							"Dock":"Fill",
							"TextAlign":"MiddleCenter",
							"DataField":"CategoryName"
						}
					]
				},
				{
					"GroupTitle":false,
					"Column":"TotalColumn",
					"TextAlign":"MiddleCenter",
					"Text":"合计"
				}
			]
		},
		"Group":[
			{
				"Name":"Group1",
				"GroupHeader":{
					"Height":0
				},
				"GroupFooter":{
					"BackColor":"99FFFF",
					"Height":0.7937,
					"Font":{
						"Name":"宋体",
						"Size":105000,
						"Bold":true,
						"Charset":134
					},
					"Control":[
						{
							"Type":"SummaryBox",
							"Name":"sumAmt",
							"BackColor":"FFFFFF",
							"AlignColumn":"TotalColumn",
							"Left":5.58271,
							"Width":3.59833,
							"Height":0.79375,
							"Border":{
								"Styles":"[DrawRight|DrawBottom]"
							},
							"TextAlign":"MiddleRight",
							"DataField":"Amount",
							"Format":"#,##0.00"
						},
						{
							"Type":"MemoBox",
							"Name":"MemoBox1",
							"BackColor":"E1FFFF",
							"AlignColumn":"City",
							"Left":-0.0264583,
							"Width":3.20146,
							"Height":0.79375,
							"Border":{
								"Styles":"[DrawLeft|DrawRight|DrawBottom]"
							},
							"Text":"合计"
						},
						{
							"Type":"SummaryBox",
							"Name":"SummaryBox1",
							"BackColor":"FFFFFF",
							"AlignColumn":"Amount",
							"Left":3.175,
							"Width":2.40771,
							"Height":0.79375,
							"Border":{
								"Styles":"[DrawRight|DrawBottom]"
							},
							"Font":{
								"Name":"宋体",
								"Size":105000,
								"Weight":400,
								"Charset":134
							},
							"TextAlign":"MiddleRight",
							"DataField":"Amount",
							"Format":"#,##0.00"
						}
					]
				}
			}
		],
		"CrossTab":{
			"PercentFormat":"0.##%",
			"HCrossFields":"CategoryName",
			"VCrossFields":"City",
			"TotalCols":1
		}
	},
	"ReportHeader":[
		{
			"Height":1.40229,
			"Control":[
				{
					"Type":"StaticBox",
					"Name":"TitleBox",
					"Center":"Horizontal",
					"Left":5.82083,
					"Top":0.396875,
					"Width":13.0969,
					"Height":0.79375,
					"Font":{
						"Name":"宋体",
						"Size":150000,
						"Bold":true,
						"Charset":134
					},
					"TextAlign":"MiddleCenter",
					"Text":"图表在报表尾 - 图表数据来自明细网格(交叉表)"
				}
			]
		}
	],
	"ReportFooter":[
		{
			"Name":"ReportFooter1",
			"Height":8.81062,
			"Control":[
				{
					"Type":"Chart",
					"Name":"Chart1",
					"BackColor":"E1FFFF",
					"Top":0.396875,
					"Width":24.7915,
					"Height":7.80521,
					"LegendValueVisible":true,
					"LegendShowSum":true,
					"LegendAtBottom":true,
					"SeriesField":"CategoryName",
					"GroupField":"City",
					"Recordset":{
						"Field":[
							{
								"Name":"City"
							},
							{
								"Name":"CategoryName"
							},
							{
								"Name":"Amount",
								"Type":"Currency"
							}
						]
					},
					"XAxis":{
						"TextFormat":"0.##",
						"CoordLinePen":{
							"Color":"FFC4C4"
						}
					},
					"YAxis":{
						"TextFormat":"0.##",
						"CoordLinePen":{
							"Color":"FFC4C4"
						}
					},
					"Y2Axis":{
						"TextFormat":"0.##",
						"CoordLinePen":{
							"Color":"FFC4C4"
						}
					},
					"ChartSeries":[
						{
							"YValueField":"Amount",
							"ValueFormat":"#,##0.00",
							"TooltipText":"[#ChartVar(SeriesLabel)#]:[#ChartVar(YVal)#]"
						}
					]
				}
			]
		}
	]
}