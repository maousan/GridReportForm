							"Width":1.40229,
							"Height":0.608542,
							"DataField":"City"
						},
						{
							"Type":"FieldBox",
							"Name":"Field2",
							"Left":0.79375,
							"Top":2.01083,
							"Width":2.38125,
							"Height":0.608542,
							"DataField":"ContactName"
						},
						{
							"Type":"FieldBox",
							"Name":"Field3",
							"Left":0.79375,
							"Top":1.40229,
							"Width":5.3975,
							"Height":0.608542,
							"DataField":"Address"
						},
						{
							"Type":"FieldBox",
							"Name":"Field4",
							"Left":0.185208,
							"Top":0.185208,
							"Width":2.01083,
							"Height":0.608542,
							"DataField":"PostalCode"
						},
						{
							"Type":"StaticBox",
							"Name":"StaticBox2",
							"Left":3.38667,
							"Top":1.5875,
