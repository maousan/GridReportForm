{
	"Version":"6.7.6.0",
	"Title":"打印：脚本-明细重复打印",
	"Author":"锐浪报表软件",
	"Description":"演示重复打印明细数据，实现要点：\r\n1、在记录集的“提交记录前脚本”属性上写报表脚本。\r\n2、利用记录集的 Duplicate 函数复制数据。\r\n3、根据某个字段确定需要复制几笔数据，实现不同明细重复不同的次数。\r\n4、增加一个计算字段，记录数据的复制序号。",
	"Font":{
		"Name":"宋体",
		"Size":105000,
		"Weight":400,
		"Charset":134
	},
	"Printer":{
		"Oriention":"Landscape",
		"LeftMargin":1,
		"TopMargin":1,
		"RightMargin":1,
		"BottomMargin":1
	},
	"DetailGrid":{
		"CenterView":true,
		"PageColumnDirection":"AcrossDown",
		"PageColumnCount":4,
		"PageColumnSpacing":0.2,
		"Recordset":{
			"ConnectionString":"XML",
			"QuerySQL":"打印：脚本-明细重复打印.txt",
			"BeforePostRecordScript":"var i = 0,\r\n    count = Sender.Fields.Item(\"RepeatTimes\").AsInteger - 1,\r\n    noField = Sender.Fields.Item(\"RepeatNo\"); \r\n\r\n//在当前正在追加的记录前面复制 count 条相同的记录\r\nwhile (i++<count) {\r\n  Sender.Duplicate();\r\n\r\n  noField.AsInteger = i; //设置序号字段的值\r\n\r\n  Sender.Post(); //Duplicate 之后必须调用 Post\r\n}\r\n\r\n//当前追加的记录在本批重复数据的最后\r\nnoField.AsInteger = i; //在当前正在追加的记录的序号字段也要设置值",
			"Field":[
				{
					"Name":"CustomerID"
				},
				{
					"Name":"CompanyName"
				},
				{
					"Name":"ContactName"
				},
				{
					"Name":"ContactTitle"
				},
				{
					"Name":"Address"
				},
				{
					"Name":"City"
				},
				{
					"Name":"Region"
				},
				{
					"Name":"PostalCode"
				},
				{
					"Name":"Country"
				},
				{
					"Name":"Phone"
				},
				{
					"Name":"Fax"
				},
				{
					"Name":"RepeatTimes",
					"Type":"Integer"
				},
				{
					"Name":"RepeatNo",
					"Type":"Integer"
				}
			]
		},
		"Column":[
			{
				"Name":"OnlyOne",
				"Width":8.5725
			}
		],
		"ColumnContent":{
			"Height":3.99521,
			"ColumnContentCell":[
				{
					"Column":"OnlyOne",
					"FreeCell":true,
					"Control":[
						{
							"Type":"FieldBox",
							"Name":"FieldBox1",
							"Left":0.79375,
							"Top":0.79375,
							"Width":1.19063,
							"Height":0.608542,
							"DataField":"Country"
						},
						{
							"Type":"StaticBox",
