		"Recordset":{
			"ConnectionString":"xml",
			"QuerySQL":"打印：脚本-明细重复打印.txt",
			"BeforePostRecordScript":"var i = 0;\r\n\r\n//在当前正在追加的记录前面复制 2 条相同的记录\r\n//实现一笔明细数据重复打印3次\r\nwhile (i++<2) {\r\n  Sender.Duplicate();\r\n  Sender.Post(); //Duplicate 之后必须调用 Post\r\n}",
