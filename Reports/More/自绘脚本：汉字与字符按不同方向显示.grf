{
	"Version":"6.8.5.9",
	"Title":"汉字与字符混合按不同方向显示",
	"Author":"锐浪软件",
	"Font":{
		"Name":"宋体",
		"Size":105000,
		"Weight":400,
		"Charset":134
	},
	"Printer":{
		"Oriention":"Landscape",
		"LeftMargin":1,
		"TopMargin":0.5,
		"RightMargin":1,
		"BottomMargin":0.5
	},
	"ReportHeader":[
		{
			"Name":"ReportHeader1",
			"Height":13.2027,
			"Control":[
				{
					"Type":"StaticBox",
					"Name":"StaticBox2",
					"BackColor":"66FFFF",
					"BackStyle":"Normal",
					"Left":1.29646,
					"Top":0.79375,
					"Width":10.2129,
					"Height":2.40771,
					"PaddingLeft":5,
					"PaddingRight":5,
					"PaddingTop":4,
					"PaddingBottom":4,
					"CustomDraw":true,
					"CustomDrawScript":"function isLiedownChar(c)\r\n{\r\n    return c.charCodeAt(0) > 127 \r\n        && c != \"（\"\r\n        && c != \"）\"\r\n        && c != \"—\";\r\n}\r\n\r\n//将文字中的汉字与ASCII字符按不同方向显示，汉字卧倒显示，ASCII字符正常显示\r\n//这段脚本代码是通用的，复制到任何一个自绘的文字部件框都有效\r\nvar g = Report.Graphics,\r\n    width = g.Width-Sender.PaddingLeft-Sender.PaddingRight,\r\n    height = g.Height-Sender.PaddingTop-Sender.PaddingBottom,\r\n    text = Sender.DisplayText,\r\n    textLen = text.length,\r\n    chars = [],\r\n    widths = [],\r\n    totalWidth = 0,\r\n    textFormat1 = Sender.TextFormat, //Ascii字符显示格式\r\n    textFormat2 = textFormat1.Clone(), //汉字显示格式\r\n    font = Sender.font,\r\n    LnSpacing = textFormat1.LineSpacing,  //行间距\r\n    i,c,\r\n    tw,th,\r\n    x,y,\r\n    rowCount, rowInfos=[], info, row;\r\n\r\n    x = Sender.PaddingLeft;\r\n    y = Sender.PaddingTop;\r\n    //Report.Utility.Alert(x);\r\n    //g.Rectangle(x, y, width, height, false);//画个矩形框看看\r\n\r\n//textFormat1.TextOrientation = 25;\r\ntextFormat2.TextOrientation = 54; //grtoL2RD2U1 54 按从左到右，从下到上方式显示文字，文字旋转，适合用来进行脊背打印。 \r\n\r\nvar tw1 = Report.Utility.FormatTextWidth(\"用\", textFormat2, font);\r\nth = Report.Utility.FormatTextHeight(\"用\",tw1, textFormat2, font);\r\n\r\nfor (i=0; i<textLen; i++) {\r\n    c = text.substr(i, 1); //c = text[i]; 必须用substr\r\n    tw = Report.Utility.FormatTextWidth(c, isLiedownChar(c)? textFormat2 : textFormat1, font);\r\n    totalWidth += tw;\r\n\r\n    chars.push(c);\r\n    widths.push(tw);\r\n}\r\n\r\n\r\n//要考虑多行显示\r\nrowCount = 1;\r\nif (totalWidth > width) {\r\n    totalWidth = 0;\r\n    for (i=0; i<textLen; i++) {\r\n        tw = widths[i];\r\n        totalWidth += tw;\r\n        if (totalWidth > width) {\r\n            info = {};\r\n            info.width = totalWidth - tw;\r\n            info.limit = i;\r\n            rowInfos.push(info);\r\n            ++rowCount;\r\n\r\n            totalWidth = tw;\r\n        }\r\n    }\r\n    info = {};\r\n    info.width = totalWidth;\r\n    info.limit = textLen;\r\n    rowInfos.push(info);\r\n}\r\nelse {\r\n    rowInfos.push({\r\n        \"limit\":textLen,\r\n        \"width\":totalWidth});\r\n}\r\n\r\ny = Sender.PaddingTop + (height - th*rowCount - LnSpacing*(rowCount-1))/2; //垂直居中显示\r\n\r\ni=0;\r\nfor (row=0; row<rowCount; row++) {\r\n    info = rowInfos[row];\r\n   x = Sender.PaddingLeft;\r\n    for (; i<info.limit; ++i) {\r\n        c = chars[i];\r\n        tw = widths[i];\r\n        g.DrawFormatText(c, x, y, tw, th, isLiedownChar(c)? textFormat2 : textFormat1);\r\n        x += tw;\r\n    }\r\n   y += th + LnSpacing;\r\n}",
					"Border":{
						"Styles":"[DrawLeft|DrawTop|DrawRight|DrawBottom]"
					},
					"Font":{
						"Name":"宋体",
						"Size":157500,
						"Weight":400,
						"Charset":134
					},
					"WordWrap":true,
					"LnSpacing":4,
					"Text":"二矿区深部开采工程——通风系统改造工程(16行盲回风井) (标段一)工程资料移交书2020-2023"
				},
				{
					"Type":"StaticBox",
					"Name":"StaticBox3",
					"BackColor":"66FFFF",
					"BackStyle":"Normal",
					"Left":1.29646,
					"Top":4.78896,
					"Width":10.2129,
					"Height":1.79917,
					"PaddingLeft":5,
					"PaddingRight":5,
					"PaddingTop":4,
					"PaddingBottom":4,
					"CustomDraw":true,
					"CustomDrawScript":"function isLiedownChar(c)\r\n{\r\n    return c.charCodeAt(0) > 127 \r\n        && c != \"（\"\r\n        && c != \"）\"\r\n        && c != \"—\";\r\n}\r\n\r\n//将文字中的汉字与ASCII字符按不同方向显示，汉字卧倒显示，ASCII字符正常显示\r\n//这段脚本代码是通用的，复制到任何一个自绘的文字部件框都有效\r\nvar g = Report.Graphics,\r\n    width = g.Width-Sender.PaddingLeft-Sender.PaddingRight,\r\n    height = g.Height-Sender.PaddingTop-Sender.PaddingBottom,\r\n    text = Sender.DisplayText,\r\n    textLen = text.length,\r\n    chars = [],\r\n    widths = [],\r\n    totalWidth = 0,\r\n    textFormat1 = Sender.TextFormat, //Ascii字符显示格式\r\n    textFormat2 = textFormat1.Clone(), //汉字显示格式\r\n    font = Sender.font,\r\n    LnSpacing = textFormat1.LineSpacing,  //行间距\r\n    i,c,\r\n    tw,th,\r\n    x,y,\r\n    rowCount, rowInfos=[], info, row;\r\n\r\n    x = Sender.PaddingLeft;\r\n    y = Sender.PaddingTop;\r\n    //Report.Utility.Alert(x);\r\n    //g.Rectangle(x, y, width, height, false);//画个矩形框看看\r\n\r\n//textFormat1.TextOrientation = 25;\r\ntextFormat2.TextOrientation = 54; //grtoL2RD2U1 54 按从左到右，从下到上方式显示文字，文字旋转，适合用来进行脊背打印。 \r\n\r\nvar tw1 = Report.Utility.FormatTextWidth(\"用\", textFormat2, font);\r\nth = Report.Utility.FormatTextHeight(\"用\",tw1, textFormat2, font);\r\n\r\nfor (i=0; i<textLen; i++) {\r\n    c = text.substr(i, 1); //c = text[i]; 必须用substr\r\n    tw = Report.Utility.FormatTextWidth(c, isLiedownChar(c)? textFormat2 : textFormat1, font);\r\n    totalWidth += tw;\r\n\r\n    chars.push(c);\r\n    widths.push(tw);\r\n}\r\n\r\n\r\n//要考虑多行显示\r\nrowCount = 1;\r\nif (totalWidth > width) {\r\n    totalWidth = 0;\r\n    for (i=0; i<textLen; i++) {\r\n        tw = widths[i];\r\n        totalWidth += tw;\r\n        if (totalWidth > width) {\r\n            info = {};\r\n            info.width = totalWidth - tw;\r\n            info.limit = i;\r\n            rowInfos.push(info);\r\n            ++rowCount;\r\n\r\n            totalWidth = tw;\r\n        }\r\n    }\r\n    info = {};\r\n    info.width = totalWidth;\r\n    info.limit = textLen;\r\n    rowInfos.push(info);\r\n}\r\nelse {\r\n    rowInfos.push({\r\n        \"limit\":textLen,\r\n        \"width\":totalWidth});\r\n}\r\n\r\ny = Sender.PaddingTop + (height - th*rowCount - LnSpacing*(rowCount-1))/2; //垂直居中显示\r\n\r\ni=0;\r\nfor (row=0; row<rowCount; row++) {\r\n    info = rowInfos[row];\r\n   x = Sender.PaddingLeft;\r\n    for (; i<info.limit; ++i) {\r\n        c = chars[i];\r\n        tw = widths[i];\r\n        g.DrawFormatText(c, x, y, tw, th, isLiedownChar(c)? textFormat2 : textFormat1);\r\n        x += tw;\r\n    }\r\n   y += th + LnSpacing;\r\n}",
					"Border":{
						"Styles":"[DrawLeft|DrawTop|DrawRight|DrawBottom]"
					},
					"Font":{
						"Name":"宋体",
						"Size":157500,
						"Weight":400,
						"Charset":134
					},
					"Text":"二矿区深部(16行盲回风井)"
				},
				{
					"Type":"StaticBox",
					"Name":"StaticBox4",
					"BackColor":"66FFFF",
					"BackStyle":"Normal",
					"Left":12.5942,
					"Top":0.79375,
					"Width":10.2129,
					"Height":2.40771,
					"PaddingLeft":5,
					"PaddingRight":5,
					"PaddingTop":4,
					"PaddingBottom":4,
					"CustomDraw":true,
					"CustomDrawScript":"function isLiedownChar(c)\r\n{\r\n    return c.charCodeAt(0) > 127 \r\n        && c != \"（\"\r\n        && c != \"）\"\r\n        && c != \"—\";\r\n}\r\n\r\n//将文字中的汉字与ASCII字符按不同方向显示，汉字卧倒显示，ASCII字符正常显示\r\n//这段脚本代码是通用的，复制到任何一个自绘的文字部件框都有效\r\nvar g = Report.Graphics,\r\n    width = g.Width-Sender.PaddingLeft-Sender.PaddingRight,\r\n    height = g.Height-Sender.PaddingTop-Sender.PaddingBottom,\r\n    text = Sender.DisplayText,\r\n    textLen = text.length,\r\n    chars = [],\r\n    widths = [],\r\n    totalWidth = 0,\r\n    textFormat1 = Sender.TextFormat, //Ascii字符显示格式\r\n    textFormat2 = textFormat1.Clone(), //汉字显示格式\r\n    font = Sender.font,\r\n    LnSpacing = textFormat1.LineSpacing,  //行间距\r\n    i,c,\r\n    tw,th,\r\n    x,y,\r\n    rowCount, rowInfos=[], info, row;\r\n\r\n    x = Sender.PaddingLeft;\r\n    y = Sender.PaddingTop;\r\n    //g.Rectangle(x, y, width, height, false);//画个矩形框看看\r\n\r\ntextFormat2.TextOrientation = 54; //grtoL2RD2U1 54 按从左到右，从下到上方式显示文字，文字旋转，适合用来进行脊背打印。 \r\n\r\nvar tw1 = Report.Utility.FormatTextWidth(\"字\", textFormat2, font);\r\nth = Report.Utility.FormatTextHeight(\"字\",tw1, textFormat2, font);\r\n\r\nfor (i=0; i<textLen; i++) {\r\n    c = text.substr(i, 1); //c = text[i]; 必须用substr\r\n    tw = g.CalcDrawFormatTextWidth(c, isLiedownChar(c)? textFormat2 : textFormat1);\r\n    totalWidth += tw;\r\n\r\n    chars.push(c);\r\n    widths.push(tw);\r\n}\r\n\r\nrowCount = 1;\r\nif (totalWidth > width) {\r\n    totalWidth = 0;\r\n    for (i=0; i<textLen; i++) {\r\n        tw = widths[i];\r\n        totalWidth += tw;\r\n        if (totalWidth > width) {\r\n            info = {};\r\n            info.width = totalWidth - tw;\r\n            info.limit = i;\r\n            rowInfos.push(info);\r\n            ++rowCount;\r\n\r\n            totalWidth = tw;\r\n        }\r\n    }\r\n    info = {};\r\n    info.width = totalWidth;\r\n    info.limit = textLen;\r\n    rowInfos.push(info);\r\n}\r\nelse {\r\n    rowInfos.push({\r\n        \"limit\":textLen,\r\n        \"width\":totalWidth});\r\n}\r\n\r\ny = Sender.PaddingTop + (height - th*rowCount - LnSpacing*(rowCount-1))/2; //垂直居中显示 \r\n\r\ni=0;\r\nfor (row=0; row<rowCount; row++) {\r\n    info = rowInfos[row];\r\n    x = Sender.PaddingLeft +(width - info.width) / 2; //水平居中显示\r\n\r\n    for (; i<info.limit; ++i) {\r\n        c = chars[i];\r\n        tw = widths[i];\r\n        //g.Rectangle(x, y, tw, th, false);//画个矩形框看看\r\n        g.DrawFormatText(c, x, y, tw, th, isLiedownChar(c)? textFormat2 : textFormat1);\r\n        x += tw;\r\n    }\r\n    y += th + LnSpacing;\r\n}\r\n\r\n//Sender.DrawDefault();",
					"Border":{
						"Styles":"[DrawLeft|DrawTop|DrawRight|DrawBottom]"
					},
					"Font":{
						"Name":"宋体",
						"Size":157500,
