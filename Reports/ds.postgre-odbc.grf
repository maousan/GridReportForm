	"Font":{
		"Name":"宋体",
		"Size":105000,
		"Weight":400,
		"Charset":134
	},
	"Printer":{
	},
	"DetailGrid":{
		"CenterView":true,
		"Recordset":{
			"ConnectionString":"Provider=MSDASQL.1;\r\nData Source=PostgreSQL35W;\r\nExtended Properties=\"DSN=PostgreSQL35W;DATABASE=TestDB\"",
			"QuerySQL":"select * from company",
			"Field":[
				{
					"Name":"id",
					"Type":"Integer"
				},
				{
					"Name":"name"
				},
				{
					"Name":"age",
					"Type":"Integer"
				},
				{
					"Name":"address"
				},
				{
					"Name":"salary",
					"Type":"Float"
				}
			]
		},
		"Column":[
			{
				"Name":"id"
			},
			{
				"Name":"name"
			},
			{
				"Name":"age"
			},
			{
				"Name":"address"
			},
			{
				"Name":"salary"
			}
		],
		"ColumnContent":{
			"Height":0.635,
			"ColumnContentCell":[
				{
					"Column":"id",
					"TextAlign":"MiddleRight",
					"DataField":"id"
				},
				{
					"Column":"name",
					"DataField":"name"
				},
				{
					"Column":"age",
					"TextAlign":"MiddleRight",
					"DataField":"age"
				},
				{
					"Column":"address",
					"DataField":"address"
				},
				{
					"Column":"salary",
					"TextAlign":"MiddleRight",
					"DataField":"salary"
				}
			]
		},
		"ColumnTitle":{
			"Height":0.635,
			"ColumnTitleCell":[
				{
					"GroupTitle":false,
					"Column":"id",
					"TextAlign":"MiddleCenter",
					"Text":"id"
				},
				{
					"GroupTitle":false,
					"Column":"name",
					"TextAlign":"MiddleCenter",
					"Text":"name"
				},
				{
					"GroupTitle":false,
					"Column":"age",
					"TextAlign":"MiddleCenter",
					"Text":"age"
				},
				{
					"GroupTitle":false,
					"Column":"address",
					"TextAlign":"MiddleCenter",
					"Text":"address"
				},
				{
					"GroupTitle":false,
					"Column":"salary",
					"TextAlign":"MiddleCenter",
					"Text":"salary"
				}
			]
		}
	}
