			"QuerySQL":"凭证(切分纸张).txt",
			"Field":[
				{
					"Name":"Brief"
				},
				{
					"Name":"SubName"
				},
				{
					"Name":"Debit",
					"Type":"Float",
					"Format":"#,##0.00"
				},
				{
					"Name":"Credit",
					"Type":"Float",
					"Format":"#,##0.00"
				},
				{
					"Name":"ID",
					"Type":"Integer"
				},
				{
					"Name":"凭证日期",
