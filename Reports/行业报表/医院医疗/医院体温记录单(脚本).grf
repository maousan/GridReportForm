		"RightMargin":1.5,
		"BottomMargin":2
	},
	"DetailGrid":{
		"CenterView":true,
		"PrintAdaptMethod":"Discard",
		"Recordset":{
			"ConnectionString":"XML",
			"QuerySQL":"医院体温记录单.xml",
