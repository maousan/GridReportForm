			"Name":"Days",
			"DataType":"Integer",
			"Value":"7"
		},
		{
			"Name":"BeginDate",
			"DataType":"DateTime",
			"Format":"yyyyMMdd",
			"Value":"2012/5/27"
		},
		{
			"Name":"TempDate",
			"DataType":"DateTime",
			"Format":"yyyyMMdd"
		},
		{
			"Name":"TempHour",
			"DataType":"Integer"
		},
		{
			"Name":"TempFloat",
			"DataType":"Float",
			"Format":"0.#°"
		},
		{
			"Name":"Hospitol",
			"Value":"锐浪软件附属医院"
		},
		{
			"Name":"name"
		},
		{
			"Name":"sex",
			"DataType":"Boolean",
			"Format":"男:女",
			"Value":"0"
		},
		{
			"Name":"age",
			"DataType":"Integer"
		},
		{
			"Name":"room_no"
		},
		{
			"Name":"in_date",
			"DataType":"DateTime",
			"Format":"yyyy年MM月dd日"
		},
		{
			"Name":"in_no"
		},
		{
			"Name":"week_no",
			"DataType":"Integer",
			"Value":"1"
		}
	],
	"ReportHeader":[
		{
			"Name":"ReportHeader1",
			"Height":2.19604,
			"Control":[
