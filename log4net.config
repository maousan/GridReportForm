<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <root>
    <!--sending all logs to all appenders-->
    <level value="ALL" />
    <appender-ref ref="console" />
    <appender-ref ref="file" />
  </root>

  <!--the console appender-->
  <appender name="console" type="log4net.Appender.ConsoleAppender">
    <!--specifying the displayed layout-->
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date %level %logger - %message%newline" />
    </layout>
  </appender>

  <!--a file appender for all logs-->
  <appender name="file" type="log4net.Appender.RollingFileAppender">
    <!--日志路径: 兼容相对路径和绝对路径，此语句等价于<File value="Logs\"/> -->
    <file type="log4net.Util.PatternString" value= "Logs\.log"/>
    <!--是否是向文件中追加日志-->
    <appendToFile value= "true"/>
    <!--保留天数-->
    <maxSizeRollBackups value= "14"/>
    <!--日志文件名格式为:2017-01-12.log-->
    <datePattern value= "'printer_'yyyy-MM-dd"/>
    <!--日志根据日期滚动-->
    <rollingStyle value= "Date"/>
    <preserveLogFileNameExtension value="true"/>
    <staticLogFileName value="false"/>
    <!-- 写入记录文件时的格式%p应该指模式如WARN，%m应该指Message值，%n应该是换行的意思。接着输出Exception -->
    <layout type="log4net.Layout.PatternLayout">
      <param name="ConversionPattern" value="%date{yyyy-MM-dd HH:mm:ss.fff} %-5p %-8type  %m%n" />
    </layout>
  </appender>
</log4net>
